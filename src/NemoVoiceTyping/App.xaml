<Application x:Class="NemoVoiceTyping.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ContextMenu x:Key="TrayMenu">
                <MenuItem Header="Show panel" Click="OnShowPanel"/>
                <MenuItem Header="Toggle dictation" Click="OnToggleDictation"/>
                <MenuItem Header="Personal dictionary..." Click="OnOpenPersonalDictionary"/>
                <Separator/>
                <MenuItem Header="Start with Windows"
                          x:Name="StartupMenu"
                          IsCheckable="True"
                          Click="OnStartupToggle"/>
                <MenuItem Header="Typing method" SubmenuOpened="OnTextInjectionMenuOpened">
                    <MenuItem Header="Automatic (recommended)" Tag="auto"
                              Click="OnTextInjectionSelected"
                              ToolTip="Types keystrokes, but automatically pastes in places where text would be garbled, like Notepad"/>
                    <MenuItem Header="Keystrokes" Tag="keystrokes"
                              Click="OnTextInjectionSelected"
                              ToolTip="Never uses the clipboard, but garbles text in Notepad and Terminal"/>
                    <MenuItem Header="Clipboard paste" Tag="clipboard"
                              Click="OnTextInjectionSelected"
                              ToolTip="Most reliable, but fails where Ctrl+V is not paste"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExit"/>
            </ContextMenu>
            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="Nemo Voice Typing (Ctrl+Alt+A)"
                            ContextMenu="{StaticResource TrayMenu}"
                            TrayLeftMouseUp="OnTrayLeftClick"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
